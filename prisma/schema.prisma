generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Facturador (existente)
model SessionData {
  id            String   @id
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  emisor        Json?
  clients       Json?
  recentClients Json?
  invoices      Json?
  settings      Json?
  logo          String?
}

// Sistema de Reservas

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  durationMin  Int           @default(60)
  price        Float?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CASH
}

enum PaymentTargetType {
  APPOINTMENT
  DOCUMENT
}

enum ClientNoteStatus {
  PENDING
  IN_PROGRESS
  WAITING
  DONE
}

enum ClientDocumentStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum MatterStatus {
  INITIAL
  IN_PROGRESS
  WAITING_ADMIN
  RESOLVED
  ARCHIVED
}

enum MatterPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TimelineEventType {
  NOTE
  EMAIL
  CALL
  DOCUMENT
  DEADLINE
  PAYMENT
  STATUS_CHANGE
}

enum DeadlineStatus {
  OPEN
  COMPLETED
  OVERDUE
  CANCELLED
}

enum DeadlineKind {
  CALENDAR_DAYS
  BUSINESS_DAYS
}

enum BillingDocumentType {
  INVOICE
  PROVISION
  EXPENSE
  ENGAGEMENT_LETTER
  QUOTE
}

enum BillingDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum StaffRole {
  OWNER
  LAWYER
  PARALEGAL
  ADMIN
}

model Appointment {
  id          String            @id @default(cuid())
  serviceId   String
  service     Service           @relation(fields: [serviceId], references: [id])
  staffUserId String?
  staffUser   StaffUser?        @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  clientName  String
  clientEmail String
  clientPhone String
  clientNie   String?

  date        DateTime
  startTime   String
  endTime     String

  status      AppointmentStatus @default(PENDING)
  paymentMethod PaymentMethod   @default(CARD)
  paymentStatus PaymentStatus   @default(PENDING)
  paymentId   String?           @unique // Referencia de Redsys u otro
  notes       String?
  adminNotes  String?
  modality    String            @default("OFFICE")

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
  @@index([status])
  @@index([clientEmail])
  @@index([staffUserId])
}

model PaymentAttempt {
  id           String            @id @default(cuid())
  orderId      String            @unique
  targetType   PaymentTargetType
  targetId     String
  amountCents  Int
  currency     String            @default("978")
  status       PaymentStatus     @default(PENDING)
  provider     String            @default("REDSYS")
  rawResponse  Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model ClientNote {
  id          String   @id @default(cuid())
  clientEmail String
  content     String
  status      ClientNoteStatus @default(PENDING)
  tags        String[]
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientEmail])
}

model ClientDocument {
  id           String               @id @default(cuid())
  clientEmail  String
  clientPhone  String
  matterId     String?
  matter       Matter?              @relation(fields: [matterId], references: [id], onDelete: SetNull)
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  description  String?
  status       ClientDocumentStatus @default(PENDING)
  adminNotes   String?
  aiAnalysis   Json?
  matchedEmail String?
  matchedScore Float?
  amountDue    Float?               // Cobro extra requerido para descargar
  isPaid       Boolean              @default(false)
  paymentId    String?              @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([clientEmail])
  @@index([matterId])
  @@index([matchedEmail])
  @@index([status])
  @@index([createdAt])
  @@index([paymentId])
}

model Matter {
  id               String             @id @default(cuid())
  reference        String             @unique
  clientName       String
  clientEmail      String
  clientPhone      String
  clientNie        String?
  title            String
  procedureType    String
  status           MatterStatus       @default(INITIAL)
  priority         MatterPriority     @default(NORMAL)
  responsible      String?
  openedAt         DateTime           @default(now())
  closedAt         DateTime?
  nextActionAt     DateTime?
  summary          String?
  riskNotes        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  documents        ClientDocument[]
  timeline         MatterTimeline[]
  deadlines        LegalDeadline[]
  billingDocuments BillingDocument[]
  communications   CommunicationLog[]

  @@index([clientEmail])
  @@index([status])
  @@index([priority])
  @@index([nextActionAt])
  @@index([createdAt])
}

model MatterTimeline {
  id          String            @id @default(cuid())
  matterId    String
  matter      Matter            @relation(fields: [matterId], references: [id], onDelete: Cascade)
  type        TimelineEventType @default(NOTE)
  title       String
  content     String?
  actor       String?
  isPublic    Boolean           @default(false)
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([matterId])
  @@index([type])
  @@index([createdAt])
}

model LegalDeadline {
  id          String         @id @default(cuid())
  matterId    String
  matter      Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime
  status      DeadlineStatus @default(OPEN)
  kind        DeadlineKind   @default(BUSINESS_DAYS)
  alertDays   Int            @default(3)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([matterId])
  @@index([dueAt])
  @@index([status])
}

model BillingDocument {
  id              String                @id @default(cuid())
  matterId        String?
  matter          Matter?               @relation(fields: [matterId], references: [id], onDelete: SetNull)
  type            BillingDocumentType   @default(INVOICE)
  status          BillingDocumentStatus @default(DRAFT)
  number          String?
  concept         String
  baseAmount      Float                 @default(0)
  vatPercent      Float                 @default(21)
  irpfPercent     Float                 @default(0)
  expenseAmount   Float                 @default(0)
  totalAmount     Float                 @default(0)
  paidAmount      Float                 @default(0)
  issuedAt        DateTime              @default(now())
  dueAt           DateTime?
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  installments    PaymentPlanInstallment[]

  @@index([matterId])
  @@index([status])
  @@index([dueAt])
  @@index([number])
}

model PaymentPlanInstallment {
  id                String          @id @default(cuid())
  billingDocumentId String
  billingDocument   BillingDocument @relation(fields: [billingDocumentId], references: [id], onDelete: Cascade)
  label             String
  amount            Float
  dueAt             DateTime
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  @@index([billingDocumentId])
  @@index([dueAt])
  @@index([paidAt])
}

model DocumentTemplate {
  id            String   @id @default(cuid())
  name          String
  procedureType String?
  description   String?
  content       String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([procedureType])
  @@index([active])
}

model CommunicationLog {
  id          String   @id @default(cuid())
  matterId    String?
  matter      Matter?  @relation(fields: [matterId], references: [id], onDelete: SetNull)
  clientEmail String
  channel     String
  subject     String?
  body        String?
  direction   String   @default("OUTBOUND")
  status      String   @default("RECORDED")
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([matterId])
  @@index([clientEmail])
  @@index([sentAt])
}

model StaffUser {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  loginSlug String?   @unique
  pinHash   String?
  role      StaffRole @default(PARALEGAL)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments Appointment[]
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}

model OfficeSettings {
  id              String   @id @default("default")
  firmName        String   @default("Consultorio de Extranjeria")
  firmEmail       String   @default("")
  firmPhone       String   @default("")
  firmAddress     String   @default("")
  startHour       Int      @default(9)
  endHour         Int      @default(18)
  slotDurationMin Int      @default(30)
  lunchStartHour  Int      @default(14)
  lunchEndHour    Int      @default(15)
  workDays        Json     @default("[1,2,3,4,5]")
  maxAppointmentsPerDay Int @default(0)
  adminPinHash    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DaySchedule {
  id                    String   @id @default(cuid())
  date                  DateTime
  startTime             String
  endTime               String
  lunchStartTime        String?
  lunchEndTime          String?
  slotDurationMin       Int?
  maxAppointmentsPerDay Int?
  allowedModality       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model BlogPost {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String?
  content        String
  coverImageUrl  String?
  imageUrls      String[]
  linkUrls       String[]
  embedUrls      String[]
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?
  newsletterSentAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  status         NewsletterStatus @default(SUBSCRIBED)
  token          String           @unique
  subscribedAt   DateTime         @default(now())
  consentAt      DateTime         @default(now())
  unsubscribedAt DateTime?
  updatedAt      DateTime         @updatedAt
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // 'user' | 'assistant' | 'system'
  content   String
  createdAt DateTime    @default(now())
}
